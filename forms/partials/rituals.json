{
  "sections": [
    {
      "type": "group",
      "fields": [
        {
          "placeholder": "Common.Type",
          "attribute": "type"
        },
        {
          "title": "Ritual.DC",
          "type": "number",
          "attribute": "dc"
        }
      ]
    },
    {
      "title": "Creature.Rituals",
      "type": "list",
      "attribute": "ritualGroups",
      "custom": {
        "itemTitle": "{{label}}",
        "itemDetail": "{% for ritual in rituals %}{{ritual.name}}{% if not forloop.last %}, {% endif %}{% endfor %}"
      },
      "form": {
        "title": "Creature.Rituals",
        "partial": "ritual-group"
      }
    },
    {
      "title": "Common.Description",
      "type": "group",
      "fields": [
        {
          "type": "textArea",
          "attribute": "text"
        }
      ]
    }
  ]
}
